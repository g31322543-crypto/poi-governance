# POI Governance Chain — copy this file to `.env` and fill in values.
# `.env` is read automatically on startup (an existing environment variable wins).

# DeepSeek API key for the System-2 dedup judge. Leave empty to run the
# offline rules fallback (the dedup chip will show "rules (offline)").
DEEPSEEK_API_KEY=

# Optional overrides:
# LAYA_SUBFOLDER=multilingual
# CONFIDENCE_AUTO=0.65
# POI_DB_PATH=poi.db
